{
  "name": "zova-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZOVA Marketplace - Production-grade Verified Local Marketplace and Admin Panel",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node scripts/start-all.js",
    "dev:all": "node scripts/start-all.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "vite",
    "build:client": "tsc && vite build",
    "build:server": "npm --prefix server run build",
    "test": "npm --prefix server test && npm --prefix client test",
    "test:serverless": "tsx scripts/test-serverless-api.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "create-admin": "node scripts/create-admin.js",
    "seed": "npm --prefix server run seed",
    "seed:wipe": "npm --prefix server run seed:wipe",
    "add-random": "npm --prefix server run add-random"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
